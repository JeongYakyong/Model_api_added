# .env 견본 — 이 파일을 .env 로 복사한 뒤 값을 채운다:
#     cp .env.example .env
# .env 는 git 에 올라가지 않는다(.gitignore).

# jeju_model 저장소의 input_data_jeju.db 절대경로 (같은 서버에 있어야 한다).
# sync_forecast.py 가 이 DB를 read-only 로 열어 수요 예측(내일·모레)만 복사해 온다.
JEJU_MODEL_DB_PATH=/home/kimjourvanne/jeju_model/data/input_data_jeju.db
